# Optional. With no key, news comes from Google News and outlet RSS feeds only.
# Free key: https://newsdata.io/register
NEWSDATA_API_KEY=
# Optional. The MBFC publisher lean. Used only by `npm run bias` (build time), never at request time.
# Basic plan (3 requests a month): https://rapidapi.com/mbfcnews/api/media-bias-fact-check-ratings-api2
RAPIDAPI_KEY=
# Optional. A contact address or URL for the User-Agent of the Wikipedia request of /api/breaking.
BREAKING_CONTACT=
